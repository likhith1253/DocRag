# Copy to .env and edit. None of these are required for local use on localhost.

# --- API security (see api/security.py) ---
# Shared secret clients send in the X-API-Key header. If unset, the API only
# answers requests from the loopback interface. SET THIS before exposing the
# API on a network or behind a reverse proxy. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DOCRAG_API_KEY=

# Directories (os.pathsep-separated) the API may index via `source_path`.
# Default: ./demo_dataset, ./papers, ./uploads
DOCRAG_DATA_ROOTS=

# Comma-separated browser origins allowed by CORS (no wildcard).
# Default: http://localhost:8501,http://127.0.0.1:8501
DOCRAG_CORS_ORIGINS=

# --- Streamlit UI ---
# Base URL of the API (default http://localhost:9001). The UI forwards
# DOCRAG_API_KEY as X-API-Key when it is set.
API_URL=http://localhost:9001

# --- Model backend ---
# transformers (default, local Hugging Face model) or ollama
LLM_BACKEND=transformers
# eager | sdpa  (eager is used automatically on Volta GPUs)
ATTN_IMPLEMENTATION=
# Cache locations for model weights (optional)
HF_HOME=
